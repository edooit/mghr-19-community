<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="planning_portal_page" name="Planning Portal">
    <t t-call="portal.portal_layout">
      <t t-set="page_name">planning</t>
      <t t-set="breadcrumbs_searchbar" t-value="False" />

      <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
        <div>
          <h2 class="mb-1">Planning</h2>
          <p class="text-muted mb-0">Visualisez et gérez les plannings de votre équipe.</p>
        </div>
      </div>

      <div id="planning_gantt_container"></div>
    </t>
  </template>
</odoo>
