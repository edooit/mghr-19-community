<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="attendance_list_view">
    <t t-call="portal.portal_layout">
      <t t-set="breadcrumbs_searchbar" t-value="True" />

      <div class="o_etech_attendance_portal container-fluid mt-3">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
          <h2 class="mb-0">Attendance Records</h2>
          <t t-call="portal.portal_searchbar" />
        </div>

        <div class="o_etech_leave_stats mb-4">
          <div class="o_etech_stat_tile">
            <div class="stat-icon o_etech_chip-primary"><i class="fa fa-list-alt" /></div>
            <div><div class="stat-number" t-esc="total_count" /><div class="stat-label">Total Records</div></div>
          </div>
          <div class="o_etech_stat_tile">
            <div class="stat-icon o_etech_chip-success"><i class="fa fa-check-circle" /></div>
            <div><div class="stat-number" t-esc="on_time_count" /><div class="stat-label">On Time</div></div>
          </div>
          <div class="o_etech_stat_tile">
            <div class="stat-icon o_etech_chip-danger"><i class="fa fa-exclamation-triangle" /></div>
            <div><div class="stat-number" t-esc="late_count" /><div class="stat-label">Late Arrivals</div></div>
          </div>
          <div class="o_etech_stat_tile">
            <div class="stat-icon o_etech_chip-info"><i class="fa fa-clock-o" /></div>
            <div><div class="stat-number" t-esc="'%.1f' % total_hours" /><div class="stat-label">Total Hours</div></div>
          </div>
        </div>

        <t t-if="not records">
          <div class="o_etech_empty_state">
            <div class="o_etech_empty_icon"><i class="fa fa-inbox" /></div>
            <p class="mb-1">No attendance records found</p>
            <p class="text-muted small mb-0">Try adjusting your search or filter criteria</p>
          </div>
        </t>

        <t t-if="records and has_grouping">
          <div class="accordion o_etech_attendance_accordion" id="attendanceAccordion">
            <t t-foreach="grouped_records" t-as="group">
              <t t-set="group_label" t-value="group[0]" />
              <t t-set="group_items" t-value="group[1]" />
              <div class="accordion-item border-0 mb-2">
                <h2 class="accordion-header" t-attf-id="heading_#{group_index}">
                  <button
                    t-attf-class="accordion-button o_etech_bg_soft rounded #{'' if group_index == 0 else 'collapsed'}"
                    type="button"
                    data-bs-toggle="collapse"
                    t-attf-data-bs-target="#collapse_#{group_index}"
                    t-attf-aria-expanded="#{'true' if group_index == 0 else 'false'}"
                    t-attf-aria-controls="collapse_#{group_index}"
                  >
                    <div class="d-flex justify-content-between align-items-center w-100 me-3">
                      <span class="fw-bold" t-esc="group_label" />
                      <span class="badge rounded-pill o_etech_chip-secondary" t-esc="len(group_items)" />
                    </div>
                  </button>
                </h2>
                <div
                  t-attf-id="collapse_#{group_index}"
                  t-attf-class="accordion-collapse collapse #{'show' if group_index == 0 else ''}"
                  t-attf-aria-labelledby="heading_#{group_index}"
                  data-bs-parent="#attendanceAccordion"
                >
                  <div class="accordion-body p-0 pt-2">
                    <t t-call="etech_attendance_portal.attendance_table">
                      <t t-set="rows" t-value="group_items" />
                    </t>
                  </div>
                </div>
              </div>
            </t>
          </div>
        </t>
        <t t-elif="records">
          <div class="o_etech_card">
            <t t-call="etech_attendance_portal.attendance_table">
              <t t-set="rows" t-value="records" />
            </t>
          </div>
        </t>

        <div class="mt-3" t-if="records">
          <t t-call="portal.pager" />
        </div>
      </div>
    </t>
  </template>

  <template id="attendance_table">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead>
          <tr>
            <th>Matricule</th>
            <th>Employee</th>
            <th>Expected</th>
            <th>Check In</th>
            <th>Check Out</th>
            <th>Delay</th>
            <th class="text-center">Work Hours</th>
            <th class="text-center">Status</th>
          </tr>
        </thead>
        <tbody>
          <t t-foreach="rows" t-as="record">
            <tr>
              <td class="text-muted fw-bold" t-esc="record.employee_id.registration_number" />
              <td>
                <div class="d-flex align-items-center gap-2">
                  <img
                    t-att-src="image_data_uri(record.employee_id.avatar_128)"
                    class="o_etech_employee_avatar"
                    alt="Employee"
                  />
                  <span class="fw-semibold" t-esc="record.employee_id.name" />
                </div>
              </td>
              <td><span t-out="record.expected_arrival" t-options="{'widget': 'float_time'}" /></td>
              <td>
                <t t-if="record.check_in"><span t-out="record.check_in" t-options="{'widget': 'datetime'}" /></t>
                <span t-else="" class="text-muted">-</span>
              </td>
              <td>
                <t t-if="record.check_out"><span t-out="record.check_out" t-options="{'widget': 'datetime'}" /></t>
                <span t-else="" class="badge rounded-pill o_etech_chip-warning">Active</span>
              </td>
              <td>
                <t t-if="record.delay_time and record.delay_time > 0">
                  <span class="text-danger fw-semibold"><t t-out="record.delay_time" t-options="{'widget': 'float_time'}" /></span>
                </t>
                <span t-else="" class="text-muted">-</span>
              </td>
              <td class="text-center">
                <span class="badge rounded-pill o_etech_chip-secondary" t-out="record.worked_hours" t-options="{'widget': 'float_time'}" />
              </td>
              <td class="text-center">
                <span t-if="record.state == 'late'" class="badge rounded-pill o_etech_chip-danger">
                  <i class="fa fa-exclamation-triangle me-1" />Late
                </span>
                <span t-elif="record.state == 'on_time'" class="badge rounded-pill o_etech_chip-success">
                  <i class="fa fa-check-circle me-1" />On Time
                </span>
                <span t-else="" class="badge rounded-pill o_etech_chip-secondary">Unknown</span>
              </td>
            </tr>
          </t>
        </tbody>
      </table>
    </div>
  </template>
</odoo>
