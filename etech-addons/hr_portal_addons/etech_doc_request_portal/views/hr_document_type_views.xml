<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="hr_document_type_view_list" model="ir.ui.view">
    <field name="name">hr.document.type.list</field>
    <field name="model">hr.document.type</field>
    <field name="arch" type="xml">
      <list>
        <field name="name" />
      </list>
    </field>
  </record>

  <record id="hr_document_type_view_form" model="ir.ui.view">
    <field name="name">hr.document.type.form</field>
    <field name="model">hr.document.type</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="name" placeholder="e.g. Attestation de travail" />
            <field name="active" />
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="hr_document_type_view_search" model="ir.ui.view">
    <field name="name">hr.document.type.search</field>
    <field name="model">hr.document.type</field>
    <field name="arch" type="xml">
      <search>
        <field name="name" />
        <filter name="inactive" string="Archived" domain="[('active', '=', False)]" />
      </search>
    </field>
  </record>

  <record id="action_hr_document_type" model="ir.actions.act_window">
    <field name="name">Liste documents</field>
    <field name="res_model">hr.document.type</field>
    <field name="view_mode">list,form</field>
  </record>

  <menuitem
    id="menu_hr_document_type"
    name="Liste documents"
    parent="hr.menu_human_resources_configuration"
    action="action_hr_document_type"
    groups="hr.group_hr_manager"
    sequence="30"
  />
</odoo>
