<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <template
    id="portal_my_home_docs"
    name="Show Documents Request"
    inherit_id="portal.portal_my_home"
    customize_show="True"
    priority="30"
  >
    <xpath expr="//div[@id='portal_common_category']" position="before">
      <div
        t-if="employee_id"
        id="portal_my_docs"
        class="o_portal_category row g-2 mt-3"
      >
        <t t-call="portal.portal_docs_entry">
          <t t-set="icon" t-value="'/etech_doc_request_portal/static/src/img/icon.svg'" />
          <t t-set="title">Docs request</t>
          <t t-set="url" t-value="'/my/documents'" />
          <t t-set="text">Make your document request</t>
          <t t-set="config_card" t-value="True" />
        </t>
      </div>
    </xpath>
  </template>
</odoo>
