<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="hr_document_request_line_view_list" model="ir.ui.view">
    <field name="name">hr.document.request.line.list</field>
    <field name="model">hr.document.request.line</field>
    <field name="arch" type="xml">
      <list decoration-muted="state == 'done'">
        <field name="employee_id" />
        <field name="request_date" />
        <field name="document_type_id" />
        <field name="delivery_mode" optional="show" />
        <field name="request_id" optional="hide" />
        <field name="state" widget="badge" decoration-info="state == 'draft'"
               decoration-warning="state == 'in_progress'" decoration-success="state == 'done'" />
        <button name="action_start" type="object" string="Démarrer" icon="fa-play"
                invisible="state != 'draft'" />
        <button name="action_done" type="object" string="Marquer traité" icon="fa-check"
                invisible="state != 'in_progress'" />
      </list>
    </field>
  </record>

  <record id="hr_document_request_line_view_form" model="ir.ui.view">
    <field name="name">hr.document.request.line.form</field>
    <field name="model">hr.document.request.line</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button name="action_start" type="object" string="Démarrer le traitement"
                  class="btn-primary" invisible="state != 'draft'" />
          <button name="action_done" type="object" string="Marquer traité"
                  class="btn-primary" invisible="state != 'in_progress'" />
          <field name="state" widget="statusbar" />
        </header>
        <sheet>
          <group>
            <group>
              <field name="request_id" />
              <field name="employee_id" readonly="1" />
              <field name="request_date" readonly="1" />
              <field name="document_type_id" readonly="1" />
              <field name="delivery_mode" readonly="1" />
            </group>
            <group>
              <field name="document" filename="document_filename"
                     invisible="delivery_mode != 'electronic'" />
              <field name="document_filename" invisible="1" />
              <field name="pickup_date" invisible="delivery_mode != 'physical'" />
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="hr_document_request_line_view_search" model="ir.ui.view">
    <field name="name">hr.document.request.line.search</field>
    <field name="model">hr.document.request.line</field>
    <field name="arch" type="xml">
      <search>
        <field name="employee_id" />
        <field name="document_type_id" />
        <field name="request_id" />
        <filter name="filter_draft" string="Brouillon" domain="[('state', '=', 'draft')]" />
        <filter name="filter_in_progress" string="En cours" domain="[('state', '=', 'in_progress')]" />
        <filter name="filter_not_done" string="À traiter" domain="[('state', '!=', 'done')]" />
        <separator />
        <filter name="filter_electronic" string="Électronique" domain="[('delivery_mode', '=', 'electronic')]" />
        <filter name="filter_physical" string="Physique" domain="[('delivery_mode', '=', 'physical')]" />
        <group>
          <filter name="group_request" string="Demande" context="{'group_by': 'request_id'}" />
          <filter name="group_employee" string="Employé" context="{'group_by': 'employee_id'}" />
          <filter name="group_state" string="Statut" context="{'group_by': 'state'}" />
        </group>
      </search>
    </field>
  </record>

  <record id="action_hr_document_request_line" model="ir.actions.act_window">
    <field name="name">Demande de documents</field>
    <field name="res_model">hr.document.request.line</field>
    <field name="view_mode">list,form</field>
    <field name="context">{'create': False, 'search_default_filter_not_done': 1}</field>
  </record>

  <menuitem
    id="menu_hr_document_request"
    name="Demande de documents"
    parent="hr.menu_hr_root"
    action="action_hr_document_request_line"
    groups="hr.group_hr_user"
    sequence="11"
  />

  <record id="hr_document_request_view_form" model="ir.ui.view">
    <field name="name">hr.document.request.form</field>
    <field name="model">hr.document.request</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <field name="state" widget="statusbar" />
        </header>
        <sheet>
          <div class="oe_title">
            <h1><field name="name" readonly="1" /></h1>
          </div>
          <group>
            <field name="employee_id" readonly="1" />
            <field name="request_date" readonly="1" />
          </group>
          <field name="line_ids" readonly="1">
            <list>
              <field name="document_type_id" />
              <field name="delivery_mode" />
              <field name="state" widget="badge" />
            </list>
          </field>
        </sheet>
      </form>
    </field>
  </record>
</odoo>
