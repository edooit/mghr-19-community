<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="hr_document_request_company_rule" model="ir.rule">
    <field name="name">HR Document Request: multi-company</field>
    <field name="model_id" ref="model_hr_document_request" />
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
  <record id="hr_document_request_line_company_rule" model="ir.rule">
    <field name="name">HR Document Request Line: multi-company</field>
    <field name="model_id" ref="model_hr_document_request_line" />
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
</odoo>
