<odoo>
  <template id="portal_edit_leave">
    <t t-call="portal.portal_layout">
      <t t-set="breadcrumbs_searchbar" t-value="False" />

      <div class="container-fluid mt-4 o_portal_edit_leave">
        <nav aria-label="breadcrumb" class="mb-4">
          <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/my/leaves">My Leaves</a></li>
            <li class="breadcrumb-item active">Edit Leave Request</li>
          </ol>
        </nav>

        <div class="row">
          <div class="col-lg-8">
            <t t-call="etech_leave_portal.edit_leave_form" />
          </div>
          <div class="col-lg-4">
            <t t-call="etech_leave_portal.create_leave_balance_card" />
          </div>
        </div>
      </div>
    </t>
  </template>

  <template id="edit_leave_form">
    <t t-set="_state_variant" t-value="{'draft': 'secondary', 'confirm': 'info', 'validate1': 'warning', 'validate': 'success', 'refuse': 'danger'}" />
    <t t-set="_state_label" t-value="{'draft': 'Draft', 'confirm': 'To Approve', 'validate1': 'To Validate', 'validate': 'Approved', 'refuse': 'Refused'}" />

    <div class="o_etech_leave_card">
      <div class="o_etech_leave_card_header">
        <i class="fa fa-pencil me-2" />Edit Leave Request
      </div>
      <div class="o_etech_leave_card_body p-4">
        <form t-attf-action="/update/leave/#{leave.id}" method="post" enctype="multipart/form-data" id="leaveForm">
          <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()" />

          <div class="row mb-3">
            <div class="col-md-6">
              <label for="emp_name" class="form-label fw-bold">
                <i class="fa fa-user me-2" />Employee *
              </label>
              <select id="emp_name" name="emp_name" class="form-select form-select-lg" required="True">
                <option value="">Select an employee...</option>
                <t t-foreach="employees" t-as="emp">
                  <option t-att-value="emp.id" t-att-selected="emp.id == leave.employee_id.id">
                    <t t-if="emp.registration_number">[<t t-esc="emp.registration_number" />] </t>
                    <t t-esc="emp.name" />
                  </option>
                </t>
              </select>
            </div>
            <div class="col-md-6">
              <label for="leave_type" class="form-label fw-bold">
                <i class="fa fa-calendar me-2" />Leave Type *
              </label>
              <select id="leave_type" name="leave_type" class="form-select form-select-lg" required="True">
                <option value="">Select leave type...</option>
                <t t-foreach="leave_types" t-as="type">
                  <option t-att-value="type.id" t-att-data-support-document="type.support_document"
                          t-att-selected="type.id == leave.holiday_status_id.id">
                    <t t-esc="type.name" />
                  </option>
                </t>
              </select>
            </div>
          </div>

          <div class="mb-3">
            <div class="form-check form-switch">
              <input class="form-check-input" type="checkbox" id="half_day" name="half_day"
                     t-att-checked="leave.request_unit_half" />
              <label class="form-check-label fw-bold" for="half_day">
                <i class="fa fa-clock-o me-2" />Half Day Leave
              </label>
            </div>
            <div id="half_day_options" class="mt-3" style="display: none;">
              <div class="col-md-6">
                <label class="form-label fw-bold">Period</label>
                <select name="period" class="form-select">
                  <option value="am" t-att-selected="leave.request_date_from_period == 'am'">Morning (AM)</option>
                  <option value="pm" t-att-selected="leave.request_date_from_period == 'pm'">Afternoon (PM)</option>
                </select>
              </div>
            </div>
          </div>

          <div class="row mb-3">
            <div class="col-md-6">
              <label for="start_date" class="form-label fw-bold">
                <i class="fa fa-calendar-plus-o me-2" />Start Date *
              </label>
              <input type="text" id="start_date" name="start_date" class="form-control form-control-lg" required="True"
                     data-widget="datetime-picker" data-widget-type="date" placeholder="Select start date"
                     t-att-value="leave.request_date_from and leave.request_date_from.strftime('%Y-%m-%d') or ''" />
            </div>
            <div class="col-md-6" id="div_end_date">
              <label for="end_date" class="form-label fw-bold">
                <i class="fa fa-calendar-minus-o me-2" />End Date *
              </label>
              <input type="text" id="end_date" name="end_date" class="form-control form-control-lg" required="True"
                     data-widget="datetime-picker" data-widget-type="date" placeholder="Select end date"
                     t-att-value="leave.request_date_to and leave.request_date_to.strftime('%Y-%m-%d') or ''" />
            </div>
          </div>

          <div class="mb-3">
            <label for="reason" class="form-label fw-bold">
              <i class="fa fa-file-text-o me-2" />Reason *
            </label>
            <textarea name="reason" class="form-control" rows="4"
                      placeholder="Please provide a reason for your leave request..."
                      required="True" t-esc="leave.name or ''" />
          </div>

          <div class="mb-3" id="attachments_section" style="display: none;">
            <label for="attachment" class="form-label fw-bold">
              <i class="fa fa-paperclip me-2" />Supporting Document
            </label>
            <input type="file" id="attachment" name="attachments" class="form-control form-control-lg" />
            <div class="form-text">Please attach any supporting documents if required for this leave type.</div>

            <div t-if="leave.supported_attachment_ids" class="mt-3">
              <label class="form-label fw-bold">Current Attachments:</label>
              <div class="list-group">
                <t t-foreach="leave.supported_attachment_ids" t-as="attachment">
                  <div class="list-group-item d-flex justify-content-between align-items-center">
                    <div><i class="fa fa-paperclip me-2" /><span t-esc="attachment.name" /></div>
                    <small class="text-muted" t-esc="attachment.create_date.strftime('%d/%m/%Y')" />
                  </div>
                </t>
              </div>
            </div>
          </div>

          <div class="mb-3">
            <div class="alert alert-info mb-0">
              <i class="fa fa-info-circle me-2" />
              <strong>Current Status:</strong>
              <span t-attf-class="badge rounded-pill o_etech_chip-#{_state_variant.get(leave.state, 'secondary')} ms-2"
                    t-esc="_state_label.get(leave.state, leave.state)" />
              <div t-if="leave.state not in ['draft', 'confirm']" class="mt-2">
                <small class="text-warning">
                  <i class="fa fa-exclamation-triangle me-1" />
                  Only leave requests in "Draft" or "To Approve" state can be modified.
                </small>
              </div>
            </div>
          </div>

          <div class="text-center">
            <button type="submit" class="btn btn-warning btn-lg px-5 me-3" t-att-disabled="leave.state not in ['draft', 'confirm']">
              <i class="fa fa-save me-2" />
              <t t-if="leave.state in ['draft', 'confirm']">Update Request</t>
              <t t-else="">Cannot Update (Read-only)</t>
            </button>
            <a href="/my/leaves" class="btn btn-etech-outline btn-lg px-5">
              <i class="fa fa-times me-2" />Cancel
            </a>
          </div>
        </form>
      </div>
    </div>

    <t t-if="error">
      <div class="modal fade" id="errorModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
          <div class="modal-content">
            <div class="modal-header bg-danger text-white">
              <h5 class="modal-title"><i class="fa fa-exclamation-triangle me-2" />Error</h5>
              <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" />
            </div>
            <div class="modal-body">
              <p class="mb-0" t-esc="error" />
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-etech-outline" data-bs-dismiss="modal">Close</button>
            </div>
          </div>
        </div>
      </div>
    </t>
  </template>
</odoo>
