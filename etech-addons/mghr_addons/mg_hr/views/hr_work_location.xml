<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="hr_work_location_view_form_inherit" model="ir.ui.view">
    <field name="name">hr.work.location.view.form.inherit</field>
    <field name="model">hr.work.location</field>
    <field name="inherit_id" ref="hr.hr_work_location_form_view"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='address_id']" position="after">
        <field name="zone_id"/>
      </xpath>
    </field>
  </record>
  <record id="hr_work_location_view_list_inherit" model="ir.ui.view">
    <field name="name">hr.work.location.view.list.inherit</field>
    <field name="model">hr.work.location</field>
    <field name="inherit_id" ref="hr.hr_work_location_tree_view"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='company_id']" position="after">
        <field name="zone_id"/>
      </xpath>
    </field>
  </record>
</odoo>
