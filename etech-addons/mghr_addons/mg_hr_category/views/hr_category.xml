<odoo>
  <record id="view_hr_contract_category_list" model="ir.ui.view">
    <field name="name">view.hr.contract.category.list</field>
    <field name="model">hr.contract.category</field>
    <field name="arch" type="xml">
      <list>
        <field name="name" />
        <field name="group_id" />
        <field name="is_manager" />
        <field name="description" />
      </list>
    </field>
  </record>

  <record id="view_hr_contract_category_form" model="ir.ui.view">
    <field name="name">view.hr.contract.category.form</field>
    <field name="model">hr.contract.category</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <h1 class="d-flex">
              <field name="name" placeholder="Category name" />
            </h1>
            <group>
              <field name="is_manager" />
              <field name="description" />
            </group>
            <group>
              <field name="group_id" options="{'no_create': True, 'no_open': True}" />
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_hr_contract_group_list" model="ir.ui.view">
    <field name="name">view.hr.contract.category.list</field>
    <field name="model">hr.contract.group</field>
    <field name="arch" type="xml">
      <list>
        <field name="name" />
        <field name="month" />
        <field name="index_ids" />
      </list>
    </field>
  </record>

  <record id="view_hr_contract_group_form" model="ir.ui.view">
    <field name="name">view.hr.contract.group.form</field>
    <field name="model">hr.contract.group</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <h1 class="d-flex">
              <field name="name" placeholder="Group name" />
            </h1>
            <group>
              <label for="month" />
              <div>
                <field name="month" class="oe_inline" />
                months
              </div>
            </group>
          </group>
          <group>
            <field name="index_ids" widget="many2many_tags" />
          </group>
        </sheet>
      </form>
    </field>
  </record>
</odoo>
