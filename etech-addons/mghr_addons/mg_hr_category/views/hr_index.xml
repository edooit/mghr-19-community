<odoo>
  <record id="view_hr_contract_index_tree" model="ir.ui.view">
    <field name="name">view.hr.contract.index.tree</field>
    <field name="model">hr.contract.index</field>
    <field name="arch" type="xml">
      <list>
        <field name="index" />
        <field name="group_id" />
      </list>
    </field>
  </record>

  <record id="view_hr_contract_index_form" model="ir.ui.view">
    <field name="name">view.hr.contract.index.form</field>
    <field name="model">hr.contract.index</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <group>
              <field name="index" />
            </group>
            <group>
              <field name="group_id" />
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>
</odoo>
