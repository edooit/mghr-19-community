<odoo>
  <record id="view_attendance_list_inherit" model="ir.ui.view">
    <field name="name">hr.attendance.list.inherit</field>
    <field name="model">hr.attendance</field>
    <field name="inherit_id" ref="hr_attendance.view_attendance_tree"/>
    <field name="arch" type="xml">
      <field name="check_in" position="before">
        <field name="expected_arrival" widget="float_time"/>
      </field>
      <field name="check_out" position="after">
        <field
            name="state"
            decoration-success="state == 'no_time'"
            decoration-danger="state == 'late'"
            widget="badge"

        />
        <field name="delay_time" widget="float_time"/>
      </field>
    </field>
  </record>
</odoo>
