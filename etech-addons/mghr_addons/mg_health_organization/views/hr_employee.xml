<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="health_organization_view_employee_form_inherit" model="ir.ui.view">
    <field name="name">health.organization.view.employee.form.inherit</field>
    <field name="model">hr.employee</field>
    <field name="inherit_id" ref="hr.view_employee_form" />
    <field name="arch" type="xml">
      <xpath expr="//group[@name='settings_group']" position="inside">
        <group string="Health organisation">
             <field
          name="health_organization_id"
          options="{'no_create': True, 'no_open': True}"
        />
        </group>
      </xpath>
    </field>
  </record>
</odoo>
