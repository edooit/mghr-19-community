<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="hr_payslip_config_views_rule" model="ir.rule">
    <field name="name">Hr payslip state multi-company rule</field>
    <field name="model_id" ref="model_hr_payslip_config" />
    <field
      name="domain_force"
    >['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
  </record>

  <record id="hr_payslip_resume_views_rule" model="ir.rule">
    <field name="name">Hr payslip resume multi-company rule</field>
    <field name="model_id" ref="model_payslip_resume" />
    <field
      name="domain_force"
    >['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
  </record>
</odoo>
