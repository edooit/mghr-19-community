<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="action_mg_payslip_input" model="ir.actions.act_window">
    <field name="name">Import payslip input</field>
    <field name="res_model">hr.payslip.input</field>
    <field name="view_id" ref="view_mg_payslip_input_list"/>
    <field name="view_mode">list,form</field>
    <field name="domain">
      [
      ('number','!=', False),
      ('date','!=', False),
      ('company_id', 'in', allowed_company_ids)
      ]
    </field>
    <field name="context">{'default_company_id': allowed_company_ids[0]}</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        Import payslip input
      </p>
    </field>
  </record>
</odoo>
