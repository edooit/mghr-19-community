<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="paperformat_frenchcheck" model="report.paperformat">
    <field name="name">French Bank Check</field>
    <field name="format">A4</field>
    <field name="header_line" eval="True"/>
    <field name="orientation">Portrait</field>
    <field name="margin_top">4</field>
    <field name="margin_bottom">3</field>
    <field name="margin_left">2</field>
    <field name="margin_right">2</field>
    <field name="dpi">80</field>
  </record>

  <record id="mg_hr_holidays.action_report_hr_leave" model="ir.actions.report">
    <field name="name">HR Leave Report</field>
    <field name="model">hr.leave</field>
    <field name="binding_type">report</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">mg_hr_holidays.mg_hr_leave_template</field>
    <field name="report_file">mg_hr_holidays.mg_hr_leave_template</field>
    <field name="print_report_name">'Leave request - %s - %s - %s' % (object.employee_id.registration_number,object.employee_id.name,object.company_id.name)
    </field>
    <field name="binding_model_id" ref="model_hr_leave"/>
  </record>
</odoo>
