<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="view_hr_leave_allocation_filter_inherit" model="ir.ui.view">
    <field name="name">view.hr.leave.allocation.filter.inherit</field>
    <field name="model">hr.leave.allocation</field>
    <field name="inherit_id" ref="hr_holidays.view_hr_leave_allocation_filter"/>
    <field name="arch" type="xml">
      <xpath expr="//search//field[@name='employee_id']" position="after">
        <field name="registration_number"/>
      </xpath>
      <xpath expr="//search//group/filter[@name='group_employee']" position="after">
        <filter string="Registration number" name="registration_number" context="{'group_by': 'registration_number'}"/>
      </xpath>
    </field>
  </record>
  <record id="hr_leave_allocation_view_inherit" model="ir.ui.view">
    <field name="name">hr.leave.allocation.tree.inherit</field>
    <field name="model">hr.leave.allocation</field>
    <field name="inherit_id" ref="hr_holidays.hr_leave_allocation_view_tree"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='employee_id']" position="after">
        <field name="registration_number"/>
      </xpath>
    </field>
  </record>
</odoo>
