<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="hr_attendance_view_filter_inherit" model="ir.ui.view">
    <field name="name">hr.attendance.view.filter.inherit</field>
    <field name="model">hr.attendance</field>
    <field name="inherit_id" ref="hr_attendance.hr_attendance_view_filter"/>
    <field name="arch" type="xml">
      <xpath expr="//search//field[@name='employee_id']" position="after">
        <field name="registration_number"/>
      </xpath>
      <xpath expr="//search//group/filter[@name='employee']" position="after">
        <filter string="Registration number" name="registration_number" context="{'group_by': 'registration_number'}"/>
      </xpath>
    </field>
  </record>
  <record id="hr_attendance_view_inherit" model="ir.ui.view">
    <field name="name">hr.attendance.tree.inherit</field>
    <field name="model">hr.attendance</field>
    <field name="inherit_id" ref="hr_attendance.view_attendance_tree"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='employee_id']" position="after">
        <field name="registration_number"/>
      </xpath>
    </field>
  </record>
</odoo>
