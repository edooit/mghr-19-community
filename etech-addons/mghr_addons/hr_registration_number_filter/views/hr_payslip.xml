<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="view_hr_payslip_filter_inherit" model="ir.ui.view">
    <field name="name">view.hr.payslip.filter.inherit</field>
    <field name="model">hr.payslip</field>
    <field name="inherit_id" ref="hr_payroll.view_hr_payslip_filter"/>
    <field name="arch" type="xml">
      <xpath expr="//search//field[@name='employee_id']" position="after">
        <field name="registration_number"/>
      </xpath>
      <xpath expr="//search//group/filter[@name='group_by_employee_id']" position="after">
        <filter string="Registration number" name="registration_number" context="{'group_by': 'registration_number'}"/>
      </xpath>
    </field>
  </record>
  <record id="hr_payslip_tree_inherit" model="ir.ui.view">
    <field name="name">hr.payslip.tree.inherit</field>
    <field name="model">hr.payslip</field>
    <field name="inherit_id" ref="hr_payroll.view_hr_payslip_tree"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='employee_id']" position="after">
        <field name="registration_number"/>
      </xpath>
    </field>
  </record>
</odoo>
