<?xml version='1.0' encoding='utf-8' ?>
<odoo>
  <record id="payslip_payment_mode_tree_view" model="ir.ui.view">
    <field name="name">hr.payslip.payment.mode.list</field>
    <field name="model">hr.payslip.payment.mode</field>
    <field name="arch" type="xml">
      <list name="Payslip payment mode">
        <field name="name"/>
        <field name="note"/>
      </list>
    </field>
  </record>
  <record id="payslip_payment_mode_form_view" model="ir.ui.view">
    <field name="name">hr.payslip.payment.mode.form</field>
    <field name="model">hr.payslip.payment.mode</field>
    <field name="arch" type="xml">
      <form name="Payslip payment mode">
        <sheet>
          <group>
            <group>
              <field name="name"/>
              <field name="note"/>
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>
</odoo>
